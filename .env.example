# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file (it is listed in .gitignore).

# --- Hindsight (agent memory) ---
# Base URL of your Hindsight instance. Hindsight Cloud (https://ui.hindsight.vectorize.io)
# is the default; use your own URL if you self-host.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# API key from your Hindsight Cloud dashboard
HINDSIGHT_API_KEY=your-hindsight-api-key
# Name of the memory bank the incidents are stored in
HINDSIGHT_BANK_ID=incident-response-agent

# --- Groq (LLM, via its OpenAI-compatible API) ---
# API key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# Optional. Defaults to openai/gpt-oss-120b if unset.
GROQ_MODEL=openai/gpt-oss-120b
